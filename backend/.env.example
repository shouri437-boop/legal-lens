# Backend environment for Legal Lens. Copy to backend/.env and fill in.
# Real environment variables override values in this file.

# Must use the postgresql+asyncpg:// scheme. Port must match docker-compose (5432).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/legal_lens

CORS_ORIGINS=http://localhost:3000

# Local dev only: acts as a fixed dev user. Never enable on a shared deployment.
DEBUG=true
AUTH_DISABLED=true

# Required: https://console.groq.com/keys
GROQ_API_KEY=
# Optional: comma-separated pool of keys (per-agent affinity and failover)
GROQ_API_KEYS=

# Optional: needed for geospatial generation (Geocoding API)
GOOGLE_MAPS_API_KEY=

# Optional: set to use Google Cloud Storage instead of backend/storage/
# GCS_BUCKET=

# Optional model overrides (see backend/app/config.py for defaults)
# FLASH_MODEL=groq/openai/gpt-oss-20b
# PRO_MODEL=groq/openai/gpt-oss-120b
# RAG_MODEL=groq/openai/gpt-oss-20b
